# Copy to .env (git-ignored) and adjust. docker compose reads it automatically.

# Required in any real deployment: at least 32 bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=

# Access token lifetime in minutes
JWT_TTL_MINUTES=60

# Database credentials (also used to initialise the postgres container)
DB_USERNAME=helpdesk
DB_PASSWORD=helpdesk

# dev | demo | prod — comma separated. "demo" seeds the Acme and Globex organizations.
SPRING_PROFILES_ACTIVE=prod,demo

# Only needed when the SPA is served from a different origin (e.g. Vite dev server)
CORS_ALLOWED_ORIGINS=
